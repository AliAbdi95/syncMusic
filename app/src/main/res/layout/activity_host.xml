<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="میزبان (Host)"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvSessionCode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="کد سشن: ----"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#03DAC5"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="در حال راه‌اندازی..."
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="کلاینت‌های متصل:"
        android:textColor="#FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvClients"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:text="هنوز کسی وصل نشده"
        android:textColor="#888888"
        android:background="#1E1E1E"
        android:padding="12dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDownload"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/download_song"
        app:cornerRadius="12dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDownloadStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#AAAAAA"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPlay"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/play_synced"
        android:enabled="false"
        app:cornerRadius="12dp"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/stop"
        style="@style/Widget.Material3.Button.OutlinedButton"
        app:strokeColor="#FFFFFF"
        android:textColor="#FFFFFF"
        app:cornerRadius="12dp" />

    <TextView
        android:id="@+id/tvPlayerStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#03DAC5"
        android:gravity="center"
        android:layout_marginTop="16dp" />

</LinearLayout>
